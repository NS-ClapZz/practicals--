<Window x:Class="ShopSystem.Desktop.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Вход" Height="260" Width="360" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Вход в ShopSystem" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
        <TextBlock Text="Логин" /><TextBox x:Name="UserBox" Margin="0,3,0,10" />
        <TextBlock Text="Пароль" /><PasswordBox x:Name="PasswordBox" Margin="0,3,0,12" />
        <Button Content="Войти" Click="Submit_Click" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
