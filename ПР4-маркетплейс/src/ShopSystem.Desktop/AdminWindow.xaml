<Window x:Class="ShopSystem.Desktop.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Администрирование магазина" Height="720" Width="1050" MinHeight="600" MinWidth="850">
    <Grid Margin="12">
        <TabControl>
            <TabItem Header="Товары">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="ProductsGrid" Grid.Row="0" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="ProductSelectionChanged" />
                    <WrapPanel Grid.Row="1" Margin="0,8">
                        <TextBox x:Name="ProductNameBox" Width="170" Margin="3" ToolTip="Название" />
                        <TextBox x:Name="ProductDescriptionBox" Width="210" Margin="3" ToolTip="Описание" />
                        <TextBox x:Name="ProductPriceBox" Width="80" Margin="3" ToolTip="Цена" />
                        <TextBox x:Name="ProductImageBox" Width="150" Margin="3" ToolTip="Путь к изображению" />
                        <TextBox x:Name="ProductStockBox" Width="70" Margin="3" ToolTip="Остаток" />
                        <TextBox x:Name="ProductCategoryIdBox" Width="90" Margin="3" ToolTip="ID категории" />
                        <CheckBox x:Name="ProductAvailableBox" Content="Доступен" IsChecked="True" VerticalAlignment="Center" Margin="8" />
                    </WrapPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Добавить товар" Click="CreateProduct_Click" Margin="3" Padding="8,4" />
                        <Button Content="Сохранить изменения" Click="UpdateProduct_Click" Margin="3" Padding="8,4" />
                        <Button Content="Обновить список" Click="RefreshProducts_Click" Margin="3" Padding="8,4" />
                        <Button Content="Переключить доступность" Click="ToggleProduct_Click" Margin="3" Padding="8,4" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Категории">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="CategoriesGrid" Grid.Row="0" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="CategorySelectionChanged" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                        <TextBox x:Name="CategoryNameBox" Width="260" Margin="3" ToolTip="Название категории" />
                        <Button Content="Добавить категорию" Click="CreateCategory_Click" Margin="3" Padding="8,4" />
                        <Button Content="Переименовать выбранную" Click="UpdateCategory_Click" Margin="3" Padding="8,4" />
                        <Button Content="Обновить список" Click="RefreshCategories_Click" Margin="3" Padding="8,4" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Пункты выдачи">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="PickupGrid" Grid.Row="0" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="PickupSelectionChanged" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                        <TextBox x:Name="PickupNameBox" Width="200" Margin="3" ToolTip="Название ПВЗ" />
                        <TextBox x:Name="PickupAddressBox" Width="320" Margin="3" ToolTip="Адрес" />
                        <CheckBox x:Name="PickupActiveBox" Content="Активен" IsChecked="True" VerticalAlignment="Center" Margin="8" />
                        <Button Content="Добавить ПВЗ" Click="CreatePickup_Click" Margin="3" Padding="8,4" />
                        <Button Content="Сохранить изменения" Click="UpdatePickup_Click" Margin="3" Padding="8,4" />
                        <Button Content="Обновить" Click="RefreshPickup_Click" Margin="3" Padding="8,4" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Заказы">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="OrdersGrid" Grid.Row="0" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="OrderSelectionChanged" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                        <ComboBox x:Name="OrderStatusBox" Width="220" SelectedIndex="0" Margin="3">
                            <ComboBoxItem Content="Placed"/><ComboBoxItem Content="Processing"/><ComboBoxItem Content="Shipped"/><ComboBoxItem Content="ReadyForPickup"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Cancelled"/>
                        </ComboBox>
                        <Button Content="Изменить статус выбранного заказа" Click="UpdateOrderStatus_Click" Margin="3" Padding="8,4" />
                        <Button Content="Обновить список" Click="RefreshOrders_Click" Margin="3" Padding="8,4" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Отзывы">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="ReviewsGrid" Grid.Row="0" AutoGenerateColumns="True" IsReadOnly="True" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                        <Button Content="Удалить выбранный некорректный отзыв" Click="DeleteReview_Click" Margin="3" Padding="8,4" />
                        <Button Content="Обновить отзывы" Click="RefreshReviews_Click" Margin="3" Padding="8,4" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StatusText" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8" IsHitTestVisible="False" />
    </Grid>
</Window>
