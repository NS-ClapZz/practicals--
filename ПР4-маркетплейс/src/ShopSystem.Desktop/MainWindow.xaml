<Window x:Class="ShopSystem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShopSystem — интернет-магазин" Height="720" Width="1100" MinHeight="600" MinWidth="900">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="ShopSystem" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,22,0" />
            <TextBox x:Name="SearchBox" Width="260" Height="32" VerticalContentAlignment="Center" ToolTip="Поиск по товарам" />
            <ComboBox x:Name="CategoryBox" Width="150" Height="32" Margin="4" DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="Категория" />
            <TextBox x:Name="MinPriceBox" Width="75" Height="32" VerticalContentAlignment="Center" ToolTip="Цена от" />
            <TextBox x:Name="MaxPriceBox" Width="75" Height="32" VerticalContentAlignment="Center" ToolTip="Цена до" />
            <Button Content="Найти" Click="Search_Click" />
            <Button Content="Обновить" Click="Refresh_Click" />
            <Button Content="В избранное" Click="AddFavorite_Click" />
            <Button Content="Избранное" Click="Favorites_Click" />
            <TextBlock x:Name="AccountText" Text="Гость — войдите, чтобы оформить заказ" VerticalAlignment="Center" Margin="18,0" />
            <Button Content="Регистрация" Click="Register_Click" />
            <Button Content="Войти" Click="Login_Click" />
            <Button x:Name="AdminButton" Content="Администрирование" Click="Admin_Click" Visibility="Collapsed" />
        </WrapPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="ProductsGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="*" />
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="Оценка" Binding="{Binding Rating}" Width="75" />
                    <DataGridTextColumn Header="Остаток" Binding="{Binding Stock}" Width="75" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Корзина" FontSize="20" FontWeight="SemiBold" />
                        <Button Content="Добавить выбранный товар" Click="Add_Click" />
                        <Button Content="Купить выбранный товар сразу" Click="BuyNow_Click" />
                        <WrapPanel>
                            <Button Content="− Количество" Click="DecreaseCart_Click" />
                            <Button Content="+ Количество" Click="IncreaseCart_Click" />
                            <Button Content="Удалить из корзины" Click="RemoveCart_Click" />
                        </WrapPanel>
                        <Button Content="Оформить доставку (адрес)" Click="Delivery_Click" />
                        <ComboBox x:Name="PickupPointBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" Margin="4" ToolTip="Выберите пункт выдачи" />
                        <Button Content="Оформить самовывоз" Click="Pickup_Click" />
                        <Button Content="История заказов" Click="History_Click" />
                        <Button Content="Отзывы о выбранном товаре" Click="Reviews_Click" />
                        <ComboBox x:Name="ReviewRatingBox" SelectedIndex="4" Margin="4" ToolTip="Оценка от 1 до 5">
                            <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/>
                        </ComboBox>
                        <TextBox x:Name="ReviewTextBox" Height="58" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="4" ToolTip="Текст отзыва" />
                        <Button Content="Оставить или изменить отзыв" Click="SubmitReview_Click" />
                        <ComboBox x:Name="HistorySortBox" SelectedIndex="0" Margin="4">
                            <ComboBoxItem Content="Сначала новые" Tag="newest" />
                            <ComboBoxItem Content="Сначала старые" Tag="oldest" />
                        </ComboBox>
                        <TextBlock Text="Доставка по адресу доступна при сумме больше 600 ₽." TextWrapping="Wrap" Margin="4,6" />
                    </StackPanel>
                    <ListBox x:Name="CartList" Margin="0,10,0,0" SelectedValuePath="Id">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding QuantityLabel}" />
                                    <TextBlock Text="{Binding PriceLabel}" />
                                    <TextBlock Text="{Binding LineTotalLabel}" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="StatusText" Text="Подключитесь к API и обновите каталог." Margin="4,12,0,0" />
    </Grid>
</Window>
