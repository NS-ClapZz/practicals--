<Window x:Class="ShopSystem.Desktop.RegisterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Регистрация" Height="330" Width="380" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Создать аккаунт" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBlock Text="Логин" /><TextBox x:Name="UserBox" Margin="0,3,0,8" />
        <TextBlock Text="Пароль (не менее 8 символов)" /><PasswordBox x:Name="PasswordBox" Margin="0,3,0,8" />
        <TextBlock Text="Повторите пароль" /><PasswordBox x:Name="PasswordRepeatBox" Margin="0,3,0,10" />
        <Button Content="Зарегистрироваться" Click="Submit_Click" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
